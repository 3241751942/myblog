<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.zzl.myblog.mapper.ProjectDesignMapper">

    <select id="findByProjectId" resultType="com.zzl.myblog.entity.ProjectDesign">
        SELECT id, project_id, title, content, sort
        FROM project_design
        WHERE project_id = #{projectId}
        ORDER BY sort ASC
    </select>

    <insert id="insertDesign">
        INSERT INTO project_design(project_id, title, content, sort)
        VALUES(#{projectId}, #{title}, #{content}, #{sort})
    </insert>

    <delete id="deleteById">
        DELETE FROM project_design WHERE id = #{id}
    </delete>

    <delete id="deleteByProjectId">
        DELETE FROM project_design WHERE project_id = #{projectId}
    </delete>

</mapper>